{
	"$schema": "../.schemas/collection.schema.json",
	"slug": "pages",
	"label": "Pages",
	"labelSingular": "Page",
	"storage": "git",
	"description": "Long-form pages (Terms, Privacy, License) rendered at /<slug>.",
	"supports": [
		"seo"
	],
	"sortOrder": 9,
	"fields": [
		{
			"slug": "title",
			"label": "Title",
			"type": "string",
			"required": true
		},
		{
			"slug": "last_updated",
			"label": "Last updated (shown under the title)",
			"type": "string",
			"required": false
		},
		{
			"slug": "description",
			"label": "Meta description",
			"type": "text",
			"required": false
		},
		{
			"slug": "content",
			"label": "Content",
			"type": "portableText"
		}
	]
}
