---
import Site from "@/layouts/Site.astro";
---

<Site title="Page not found">
	<div class="mx-auto max-w-3xl px-6 pt-48 pb-32 text-center">
		<div
			class="text-[clamp(6rem,20vw,10rem)] font-black leading-none tracking-tighter text-foreground/10 select-none"
			aria-hidden="true"
		>
			404
		</div>
		<h1 class="mt-6 text-3xl font-bold tracking-tighter text-foreground sm:text-4xl">Page not found</h1>
		<p class="mt-4 text-muted-foreground">The page you're looking for doesn't exist or has been moved.</p>
		<div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
			<a
				href="/"
				class="inline-flex items-center gap-2 border border-primary/80 bg-primary/10 px-8 py-3.5 text-xs uppercase tracking-[0.2em] text-primary transition-all hover:bg-primary/20"
			>
				Go home
			</a>
			<a
				href="/contact"
				class="inline-flex items-center gap-2 border border-border/60 px-8 py-3.5 text-xs uppercase tracking-[0.2em] text-muted-foreground transition-all hover:border-border hover:text-foreground"
			>
				Contact us
			</a>
		</div>
	</div>
</Site>
