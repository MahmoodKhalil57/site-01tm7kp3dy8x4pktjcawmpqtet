---
import Site from "@/layouts/Site.astro";
import { ContactPage } from "@/components/pages/contact-page";
import { getContact } from "@/lib/content";

const contact = (await getContact()) ?? {
	metaTitle: "Contact Us",
	metaDescription: "Reach out to SaaSTEMLY — whether it's a new project, a partnership inquiry, or a question about our work.",
	pageTitle: "Get in touch.",
	pageSubtitle: "Whether it's a new project, a question about our process, or a partnership inquiry — we're here to help.",
	email: "",
	emailNote: "",
	location: "",
	locationNote: "",
	hours: "",
	hoursNote: "",
	note: "",
	noteLinkLabel: "",
	noteLinkUrl: "/faq",
	formTitle: "Send a message",
	formSubtitle: "Fill out the form and we'll get back to you shortly.",
};
---

<Site title={contact.metaTitle || "Contact Us"} description={contact.metaDescription || undefined}>
	<ContactPage client:load data={contact} />
</Site>
